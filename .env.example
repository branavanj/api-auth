# Ne pas remplir à la main : ./scripts/generate-env.sh crée un .env avec des secrets aléatoires.

# --- Secrets de l'application ---
SECRET_KEY=
TOTP_ENCRYPTION_KEY=

# --- Mots de passe de l'infra (lus par docker compose) ---
POSTGRES_ADMIN_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=

# --- Connexions, pour lancer l'API sur la machine (hors Docker) ---
# Dans Docker, docker-compose.yml les remplace par les noms de services.
DATABASE_URL=postgresql+psycopg://auth_app:<APP_DB_PASSWORD>@localhost:5432/auth
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0
# Le schéma est créé par db/init/*.sql. Mettre true seulement sans Postgres (ex. SQLite).
DB_AUTO_CREATE=false

LOG_LEVEL=INFO
TOTP_ISSUER=Auth API

# --- Email : Mailpit en local (interface : http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none
EMAIL_FROM=no-reply@example.com

# Exemple Gmail (mot de passe d'application requis) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURITY=ssl
# SMTP_USER=toi@gmail.com
# SMTP_PASSWORD=...
